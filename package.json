{
  "name": "devdaniels-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "lint": "ng lint",
    "serve:ssr:devdaniels-portfolio": "node dist/devdaniels-portfolio/server/server.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,html,scss}": [
      "prettier --write",
      "ng lint"
    ]
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.1",
    "@angular/compiler": "^22.1.1",
    "@angular/core": "^22.1.1",
    "@angular/forms": "^22.1.1",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.1",
    "@angular/platform-server": "^22.1.1",
    "@angular/router": "^22.1.1",
    "@angular/ssr": "^22.1.3",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/devicon": "^35.0.1",
    "@ng-icons/font-awesome": "^35.0.1",
    "@ng-icons/simple-icons": "^35.0.1",
    "@tsparticles/angular": "^4.3.2",
    "@tsparticles/engine": "^4.3.2",
    "@tsparticles/preset-links": "^4.3.2",
    "@tsparticles/slim": "^4.3.2",
    "angularx-qrcode": "^22.0.1",
    "dompurify": "^3.4.13",
    "js-yaml": "^5.2.3",
    "marked": "^18.0.9",
    "rxjs": "~7.8.2",
    "sanitize-html": "^2.17.6",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.1",
    "@eslint/js": "^10.0.1",
    "@types/dompurify": "^3.2.0",
    "@types/jasmine": "~6.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/sanitize-html": "^2.16.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
