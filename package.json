{
  "name": "devdaniels-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "prepare": "husky && husky install",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "lint": "ng lint",
    "serve:ssr:devdaniels-portfolio": "node dist/devdaniels-portfolio/server/server.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,html,scss}": [
      "prettier --write",
      "ng lint"
    ]
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "engines": {
    "node": ">=24.19"
  },
  "dependencies": {
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@ng-icons/core": "^32.5.0",
    "@ng-icons/devicon": "^32.5.0",
    "@ng-icons/font-awesome": "^32.5.0",
    "@ng-icons/simple-icons": "^32.5.0",
    "@tsparticles/angular": "^3.0.0",
    "@tsparticles/engine": "^3.9.0",
    "@tsparticles/preset-links": "^3.2.0",
    "@tsparticles/slim": "^3.9.1",
    "dompurify": "^3.4.13",
    "js-yaml": "^4.3.1",
    "marked": "^17.0.6",
    "rxjs": "~7.8.0",
    "sanitize-html": "^2.17.6",
    "tslib": "^2.8.1",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/jasmine": "~5.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.43",
    "@types/sanitize-html": "^2.16.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^8.0.3",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "3.7.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
